<Project Sdk="Microsoft.NET.Sdk">
	<!-- Módulo MonoMod: tipos/patches daqui são mesclados no Celeste.dll pelo Celeste.Patcher. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>Celeste.Android.mm</AssemblyName>
		<RootNamespace>CelesteAndroid</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Pack de referência do Android, instalado junto com o workload.
		     SaveRedirect usa Android.OS.Environment; em runtime a API existe porque
		     o patch roda dentro do processo Android. Aqui só precisamos compilar. -->
		<MonoAndroidRefDir>$(MSBuildSDKsPath)/../../packs/Microsoft.Android.Ref.36/36.1.2/ref/net10.0/</MonoAndroidRefDir>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MonoMod.Patcher" Version="25.0.1" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Celeste">
			<HintPath>$(CelesteGameDir)Celeste.exe</HintPath>
			<Private>false</Private>
		</Reference>
		<ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" Private="false" />
		<Reference Include="Mono.Android" Condition="Exists('$(MonoAndroidRefDir)Mono.Android.dll')">
			<HintPath>$(MonoAndroidRefDir)Mono.Android.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>